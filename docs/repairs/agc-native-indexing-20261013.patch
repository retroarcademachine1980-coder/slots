+test('reviewed AGC landing is indexable in both native HTML and its sitemap',async()=>{
+ const reviewed=JSON.parse(await fs.readFile(new URL('../config/routes/manifest.json',import.meta.url),'utf8'));
+ const landing=reviewed.landings['/agc'];
+ const config={...manifest,entries:[],endpoints:{agc:{...ready,pageName:landing.pageName}},landings:{'/agc':landing}};
+ const m=await load('backend/routers',{}, {},config);
+ const response=await m.agc_Router({path:[]});
+ assert.equal(response.status,200);
+ assert.equal(response.page,'agc-page');
+ assert.equal(response.head.noIndex,false);
+ assert.ok(!response.head.metaTags.some(tag=>tag.name==='robots'&&/noindex/i.test(tag.content)));
+ assert.deepEqual(Array.from(response.head.links,link=>link.href),['https://www.spin-raiders.com/agc']);
+ const sitemap=await m.agc_SiteMap();
+ assert.equal(sitemap.length,1);
+ assert.equal(sitemap[0].url,'/agc');
+ assert.equal(sitemap[0].pageName,'agc-page');
+});
+test('native sitemap still excludes landings with either noindex instruction',async()=>{
+ const reviewed=JSON.parse(await fs.readFile(new URL('../config/routes/manifest.json',import.meta.url),'utf8'));
+ const landing=reviewed.landings['/agc'];
+ for(const seo of [{...landing.seo,noIndex:true},{...landing.seo,noIndex:false,metaTags:[{name:'robots',content:'noindex, follow'}]}]){
+  const config={...manifest,entries:[],endpoints:{agc:{...ready,pageName:landing.pageName}},landings:{'/agc':{...landing,seo}}};
+  const m=await load('backend/routers',{}, {},config);
+  assert.equal((await m.agc_SiteMap()).length,0);
+ }
+});
